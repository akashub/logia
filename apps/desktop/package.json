{
  "name": "logia-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "tauri": "tauri",
    "test:ui": "node tests/ui.cjs && node tests/models.cjs && node tests/overlay.cjs && node tests/overlay-safety.cjs && node tests/permissions.cjs && node tests/delivery.cjs",
    "test:transcript": "node --test tests/transcript.test.ts",
    "icons": "node scripts/export-icons.cjs",
    "test:unit": "node --test tests/transcript.test.ts tests/preferences.test.ts tests/dictionary.test.ts",
    "app": "tauri build --debug --bundles app && bash scripts/stable-sign.sh",
    "app:install": "pnpm app && node scripts/install-app.mjs",
    "signing:setup": "bash scripts/setup-local-signing.sh --install",
    "test:install": "node --test tests/install-app.test.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@fontsource/archivo": "5.2.8",
    "@fontsource/newsreader": "5.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.0",
    "@types/react": "18.3.26",
    "@types/react-dom": "18.3.7",
    "typescript": "5.6.3",
    "vite": "6.4.1",
    "playwright": "1.59.1"
  }
}
